{
  "name": "workcomposer-desktop",
  "version": "1.0.0",
  "description": "WorkComposer desktop application for time tracking and productivity management",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron",
    "dev": "next dev --webpack",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.16.1",
    "electron-store": "^11.0.2",
    "form-data": "^4.0.5",
    "screenshot-desktop": "^1.15.4",
    "sharp": "^0.35.3",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.workcomposer.desktop",
    "productName": "WorkComposer",
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/**"
    ],
    "extraResources": [
      {
        "from": "resources/BrowserUrlReader.exe",
        "to": "BrowserUrlReader.exe"
      },
      {
        "from": "resources/LocationReader/bin/Release/net8.0-windows10.0.19041.0/win-x64/publish",
        "to": "LocationReader"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/workcomposer.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
